<script>
const startDate=new Date(2025,6,7,3,45,0);function updateCounter(){let now=new Date(),ms=now-startDate,days=Math.max(0,Math.floor(ms/86400000)),years=Math.floor(days/365.2425),months=Math.floor((days-years*365.2425)/30.436875),rest=days-Math.floor(years*365.2425)-Math.floor(months*30.436875);document.getElementById('counter').innerHTML=`<div class="countbox"><strong>${days}</strong><span>dias de história</span></div><div class="countbox"><strong>${years}</strong><span>anos</span></div><div class="countbox"><strong>${months}</strong><span>meses aprox.</span></div>`}updateCounter();
const letters={saudade:'Meu neném, se vc tá sentindo saudade, lembra q mesmo quando a gente não tá pertinho, vc continua sendo parte dos meus pensamentos. Queria te dar um abraço bem apertado agora. Eu te amo, minha vidinha. 🤍',triste:'Meu amor, respira um pouquinho. Você não precisa dar conta de tudo o tempo todo. Eu torço por vc, acredito em vc e quero te ver bem. Que essa cartinha te lembre q vc é muito importante pra mim. 🤍',amor:'Higor, meu nescauzinho, eu te amo nos dias leves e nos dias difíceis. Não precisa ser perfeito pra ser amado. Quero que a gente continue conversando, aprendendo e cuidando um do outro. Vc é muito especial pra mim. 🤍'};function openLetter(k){document.getElementById('letterOut').textContent=letters[k]}
const quiz=[{q:'Em que data nossa história começou?',opts:['07/07/2025','07/09/2025','24/09/2025'],correct:0,ok:'Issooo! 07/07/2025, às 03:45, numa partida de Free Fire. 🤍',no:'Quase! Foi dia 07/07/2025, às 03:45. Nosso começo improvável. ♡'},{q:'Como eu chamo meu amor?',opts:['Nescauzinho','Meu astronauta','Meu príncipe do gelo'],correct:0,ok:'Meu nescauzinhooo! Você conhece a dona do seu coração. ♡',no:'Meu nescauzinho! Agora já sabe, viu? 🤍'},{q:'O que eu quero construir com você?',opts:['Uma história com carinho e respeito','Uma competição','Uma vida sem conversar'],correct:0,ok:'Sim! Quero crescer com vc, conversar e cuidar da nossa história. 🤍',no:'Quero construir uma história com amor, conversa e respeito. ♡'}];let qi=0;function startQuiz(){qi=0;showQuiz()}function showQuiz(){let q=quiz[qi],out=document.getElementById('gameOut');out.innerHTML=`<strong>Quiz ${qi+1}/${quiz.length}</strong><p class="quiz-question">${q.q}</p><div class="choices">${q.opts.map((x,i)=>`<button onclick="answerQuiz(${i})">${x}</button>`).join('')}</div>`}function answerQuiz(i){let q=quiz[qi];document.getElementById('gameOut').textContent=(i===q.correct?q.ok:q.no);qi++;if(qi<quiz.length){setTimeout(showQuiz,1700)}else{setTimeout(()=>document.getElementById('gameOut').textContent='Fim do quiz! O maior prêmio é continuar escrevendo nossa história juntos. 🤍',1700)}}
const surprises=['Vale um abraço apertado assim que a gente se encontrar. 🤍','Lembrete: sua menina tá torcendo muito por vc.','Se eu pudesse escolher de novo, ainda ia querer conhecer você naquela partida. ♡','Missão do dia: se cuidar e lembrar que você é amado.','Um beijo imaginário na testa e um abraço bem demorado.'];function surprise(){document.getElementById('gameOut').textContent=surprises[Math.floor(Math.random()*surprises.length)]}const wheel=['Um beijo demorado 💋','Um abraço de urso 🤍','Uma declaração de amor 💌','Uma noite conversando 🌙','Escolher um filme juntos 🎬','Um elogio bem sincero 🌹'];function spinLove(){document.getElementById('gameOut').textContent='A roleta escolheu: '+wheel[Math.floor(Math.random()*wheel.length)]+'! ♡'}let clue=0;const clues=['Pista 1: procure no lugar onde esta história está guardada… nesta página!','Pista 2: releia a carta e encontre a lembrança do nosso começo.','Tesouro encontrado: meu maior desejo é continuar criando memórias com vc, Higor. 🤍'];function treasure(){document.getElementById('gameOut').textContent=clues[clue];clue=(clue+1)%clues.length}
const symbols=['♡','🌹','💌','⭐','♡','🌹','💌','⭐'];let first=null,lock=false,matches=0;function resetMemory(){first=null;lock=false;matches=0;let shuffled=[...symbols].sort(()=>Math.random()-.5);const board=document.getElementById('memory');board.innerHTML='';shuffled.forEach((s,i)=>{let b=document.createElement('button');b.className='memory-tile';b.textContent='?';b.setAttribute('aria-label','Carta escondida');b.onclick=()=>flip(b,s);board.appendChild(b)});document.getElementById('gameOut').textContent='Encontre os 4 pares! Toque nas cartas para revelar. 🤍'}function flip(b,s){if(lock||b.classList.contains('open')||b.dataset.matched)return;b.textContent=s;b.classList.add('open');if(!first){first={b,s};return}if(first.s===s){first.b.dataset.matched='1';b.dataset.matched='1';matches++;first=null;if(matches===4)document.getElementById('gameOut').textContent='Conseguiu todos os pares! Igual a gente, combinando do nosso jeitinho. 🤍'}else{lock=true;let old=first.b;first=null;setTimeout(()=>{old.textContent='?';b.textContent='?';old.classList.remove('open');b.classList.remove('open');lock=false},750)}}resetMemory();
</script></body></html>
