tro{text-align:center;max-width:650px;margin:0 auto 25px}.paper{background:#fff;border:1px solid #f0d7de;box-shadow:0 12px 35px #6b18300d;border-radius:18px;padding:clamp(20px,5vw,42px)}.letter{white-space:pre-line;font-size:17px;line-height:1.95}.letter-title{text-align:center;font-size:24px;color:var(--wine);margin:0 0 25px}.letter-sign{text-align:right;color:var(--wine);font-style:italic;margin-top:25px}.album-grid,.game-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.photo{min-height:175px;background:linear-gradient(145deg,#fff0f3,#f7d6df);border:1px dashed #d98da0;border-radius:14px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:18px;color:#8c3851}.photo .heart{font-size:36px}.photo small{font:12px Arial,sans-serif}.btn{border:0;background:var(--wine);color:white;border-radius:999px;padding:11px 18px;margin:4px 3px;box-shadow:0 5px 14px #851b3b20}.btn.alt{background:#f8e0e7;color:var(--wine);box-shadow:none}.center{text-align:center}.music-card{max-width:550px;margin:auto;text-align:center;background:linear-gradient(140deg,#fff,#fff0f4);border:1px solid #f0d1da;padding:25px;border-radius:20px}.music-note{font-size:45px}.music-card a{color:var(--wine)}.mini-card{background:#fff;border:1px solid #f0d7de;border-radius:16px;padding:20px;text-align:center;min-height:145px}.mini-card h3{font-size:21px;font-weight:normal;color:var(--wine);margin:4px 0}.output{min-height:45px;margin:15px auto 0;max-width:620px;background:#fff5f7;border-radius:12px;padding:13px;text-align:center}.choices{display:flex;flex-wrap:wrap;justify-content:center;gap:7px}.choices button{border:1px solid #e5b5c3;background:white;color:var(--wine);border-radius:999px;padding:8px 13px}.memory-board{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;max-width:420px;margin:18px auto}.memory-tile{aspect-ratio:1;border:1px solid #e6b8c4;background:#fff0f4;border-radius:12px;font-size:26px;color:var(--wine)}.memory-tile.open{background:#fff;color:var(--wine)}.quiz-question{font-size:20px}.footer{text-align:center;padding:30px 10px;color:#985268;font-style:italic}.counter{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:20px 0}.countbox{background:#ffffff18;border:1px solid #ffffff45;border-radius:12px;padding:12px 18px;min-width:75px}.countbox strong{display:block;font:28px Arial,sans-serif}.countbox span{font:11px Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}@media(min-width:700px){.album-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.game-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.photo{min-height:220px}}@media(max-width:420px){.nav{justify-content:flex-start}.letter{font-size:16px}.memory-board{gap:5px}.memory-tile{font-size:22px}}
